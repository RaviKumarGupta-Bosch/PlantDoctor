<Window x:Class="DeviceSimulator.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Device Simulator — Sensors &amp; Scanner" Height="780" Width="1200">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Open All Devices" Command="{Binding OpenAllCommand}"/>
                <MenuItem Header="_Close All Devices" Command="{Binding CloseAllCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Global device controls -->
        <Border Grid.Row="1" BorderBrush="#AAA" BorderThickness="1" CornerRadius="6"
                Background="#FAFAFA" Margin="4,8,4,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scanner Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="80" SelectedItem="{Binding ScannerPort}" VerticalAlignment="Center">
                    <sys:String>COM1</sys:String>
                    <sys:String>COM2</sys:String>
                    <sys:String>COM3</sys:String>
                    <sys:String>COM4</sys:String>
                    <sys:String>COM5</sys:String>
                    <sys:String>COM6</sys:String>
                </ComboBox>

                <TextBlock Text="Emit interval (ms):" VerticalAlignment="Center" Margin="18,0,6,0"/>
                <TextBox Width="70" VerticalAlignment="Center"
                         Text="{Binding EmitIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>

                <Border Width="1" Background="#CCC" Margin="18,2"/>

                <Button Content="Open All" Command="{Binding OpenAllCommand}" Margin="12,0,0,0" Padding="10,3"/>
                <Button Content="Close Sensors" Command="{Binding CloseSensorsCommand}" Margin="8,0,0,0" Padding="10,3"/>
                <Button Content="Close Scanner" Command="{Binding CloseScannerCommand}" Margin="8,0,0,0" Padding="10,3"/>
                <Button Content="Close All" Command="{Binding CloseAllCommand}" Margin="8,0,0,0" Padding="10,3"
                        FontWeight="Bold" Background="#FFEBEE"/>
            </StackPanel>
        </Border>

        <!-- Device blocks: 3 sensors + scanner -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Devices}" Margin="4,8,4,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#888" BorderThickness="1.5" CornerRadius="6"
                            Background="White" Margin="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Icon}" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TransportLabel}" FontStyle="Italic" Foreground="#555"
                                       FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Endpoint}" Foreground="#777" FontSize="10"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                         Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding LastValue}" FontSize="11" HorizontalAlignment="Center"
                                       Margin="0,4,0,0" Foreground="#333"/>
                            <TextBlock Text="{Binding SentCount, StringFormat='sent: {0}'}" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="#777"/>
                            <TextBlock Text="{Binding LastError}" FontSize="10" Foreground="#C62828"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="Open" Padding="10,2"
                                        Command="{Binding DataContext.OpenDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Close" Padding="10,2" Margin="6,0,0,0"
                                        Command="{Binding DataContext.CloseDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="4,8,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Emitted Data (device → main application)" Grid.Column="0" Margin="4">
                <ListBox ItemsSource="{Binding EmittedFeed}" FontFamily="Consolas" FontSize="11"/>
            </GroupBox>

            <GroupBox Header="Fault Injection" Grid.Column="1" Margin="4">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Sensor Timeout" Command="{Binding InjectSensorTimeoutCommand}"/>
                        <Button Content="COM Disconnect" Command="{Binding InjectComDisconnectCommand}"/>
                        <Button Content="Overflow"       Command="{Binding InjectOverflowCommand}"/>
                        <Button Content="Out of Range"   Command="{Binding InjectOutOfRangeCommand}"/>
                    </ToolBar>
                    <DataGrid ItemsSource="{Binding InjectedFaults}" AutoGenerateColumns="True" IsReadOnly="True"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
