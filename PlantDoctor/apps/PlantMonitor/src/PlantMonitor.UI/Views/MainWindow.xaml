<Window x:Class="PlantMonitor.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Plant Monitor — Main Application" Height="820" Width="1360">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Open _Log Folder" Command="{Binding OpenLogFolderCommand}"/>
                <MenuItem Header="Export _Artifacts..." Command="{Binding ExportZipCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Connections">
                <MenuItem Header="_Reconnect All" Command="{Binding StartAllCommand}"/>
                <MenuItem Header="Disconnect _Sensors" Command="{Binding DisconnectSensorsCommand}"/>
                <MenuItem Header="Disconnect S_canner" Command="{Binding DisconnectScannerCommand}"/>
                <MenuItem Header="Disconnect _All" Command="{Binding DisconnectAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" BorderBrush="#2E7D32" BorderThickness="2" CornerRadius="6"
                Background="#E8F5E9" Margin="4,8,4,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏭 " FontSize="18" VerticalAlignment="Center"/>
                <TextBlock Text="Ingestion:" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding HubStatus}" Margin="6,0,0,0" Foreground="#2E7D32" VerticalAlignment="Center"/>

                <Border Width="1" Background="#A5D6A7" Margin="18,2"/>

                <Button Content="Reconnect All" Command="{Binding StartAllCommand}" Padding="10,3"/>
                <Button Content="Disconnect Sensors" Command="{Binding DisconnectSensorsCommand}" Margin="8,0,0,0" Padding="10,3"/>
                <Button Content="Disconnect Scanner" Command="{Binding DisconnectScannerCommand}" Margin="8,0,0,0" Padding="10,3"/>
                <Button Content="Disconnect All" Command="{Binding DisconnectAllCommand}" Margin="8,0,0,0" Padding="10,3"
                        FontWeight="Bold" Background="#FFEBEE"/>
            </StackPanel>
        </Border>

        <!-- Sensor / scanner connection data, one card per inbound device channel -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Channels}" Margin="4,8,4,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#888" BorderThickness="1.5" CornerRadius="6"
                            Background="White" Margin="6" Padding="10">
                        <StackPanel>
                            <TextBlock Text="{Binding Icon}" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TransportLabel}" FontStyle="Italic" Foreground="#555"
                                       FontSize="11" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Endpoint}" Foreground="#777" FontSize="10"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,4,0"
                                         Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"/>
                                <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding LastValue}" FontSize="11" HorizontalAlignment="Center"
                                       Margin="0,4,0,0" Foreground="#333"/>
                            <TextBlock Text="{Binding MessageCount, StringFormat='received: {0}'}" FontSize="10"
                                       HorizontalAlignment="Center" Foreground="#777"/>
                            <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#C62828"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Content="Connect" Padding="8,2"
                                        Command="{Binding DataContext.ConnectChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Disconnect" Padding="8,2" Margin="6,0,0,0"
                                        Command="{Binding DataContext.DisconnectChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="3" Margin="4,8,4,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Sensor Data (emitted by devices)" Grid.Column="0" Margin="4">
                <DataGrid ItemsSource="{Binding Readings}" AutoGenerateColumns="True" IsReadOnly="True"/>
            </GroupBox>

            <GroupBox Header="Scanner Data" Grid.Column="1" Margin="4">
                <ListBox ItemsSource="{Binding ScanFeed}" FontFamily="Consolas" FontSize="11"/>
            </GroupBox>

            <GroupBox Header="Error &amp; Event Log" Grid.Column="2" Margin="4">
                <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="True" IsReadOnly="True"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
