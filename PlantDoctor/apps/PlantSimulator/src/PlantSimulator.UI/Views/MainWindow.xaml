<Window x:Class="PlantSimulator.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="PlantSimulator" Height="820" Width="1360">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Block Diagram: 3 sensor simulators + 1 scanner, each on its own transport, feeding the main app -->
        <Border Grid.Row="1" BorderBrush="#AAA" BorderThickness="1" CornerRadius="6" Background="#FAFAFA" Margin="4,8,4,8" Padding="10">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#888" BorderThickness="1.5" CornerRadius="6" Background="White" Margin="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Icon}" FontSize="26" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding TransportLabel}" FontStyle="Italic" Foreground="#555" FontSize="11" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Status}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding LastValue}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#333"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="↓ &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; ↓ &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; ↓ &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; ↓"
                           FontSize="18" HorizontalAlignment="Center" Foreground="#666" Margin="0,2"/>

                <Border BorderBrush="#2E7D32" BorderThickness="2" CornerRadius="6" Background="#E8F5E9" Padding="10" Margin="0,2,0,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🏭 " FontSize="18"/>
                        <TextBlock Text="Main Application" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" — " VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding HubStatus}" VerticalAlignment="Center" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <!-- Scanner controls (COM port device) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock Text="Scanner Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="80" SelectedItem="{Binding ScannerPort}">
                        <sys:String>COM1</sys:String>
                        <sys:String>COM2</sys:String>
                        <sys:String>COM3</sys:String>
                        <sys:String>COM4</sys:String>
                        <sys:String>COM5</sys:String>
                        <sys:String>COM6</sys:String>
                    </ComboBox>
                    <Button Content="Connect" Command="{Binding ConnectScannerCommand}" Margin="6,0"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectScannerCommand}" Margin="0,0,6,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Margin="4" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Sensor Readings" Grid.Column="0" Margin="4">
                <DataGrid ItemsSource="{Binding Readings}" AutoGenerateColumns="True" IsReadOnly="True"/>
            </GroupBox>

            <GroupBox Header="Scanner Feed" Grid.Column="1" Margin="4">
                <ListBox ItemsSource="{Binding ScanFeed}" FontFamily="Consolas"/>
            </GroupBox>

            <GroupBox Header="Error &amp; Event Log" Grid.Column="2" Margin="4">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Sensor Timeout"  Command="{Binding InjectSensorTimeoutCommand}"/>
                        <Button Content="COM Disconnect"  Command="{Binding InjectComDisconnectCommand}"/>
                        <Button Content="Overflow"        Command="{Binding InjectOverflowCommand}"/>
                        <Button Content="Out of Range"    Command="{Binding InjectOutOfRangeCommand}"/>
                    </ToolBar>
                    <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="True" IsReadOnly="True"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>

