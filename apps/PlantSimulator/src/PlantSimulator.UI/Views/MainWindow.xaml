<Window x:Class="PlantSimulator.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="PlantSimulator" Height="720" Width="1280">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}"/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="8" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Sensor Readings" Grid.Column="0" Margin="4">
                <DataGrid ItemsSource="{Binding Readings}" AutoGenerateColumns="True" IsReadOnly="True"/>
            </GroupBox>

            <GroupBox Header="COM Port" Grid.Column="1" Margin="4">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ComboBox Width="80" SelectedItem="{Binding SelectedPort}">
                            <sys:String>COM1</sys:String>
                            <sys:String>COM2</sys:String>
                            <sys:String>COM3</sys:String>
                            <sys:String>COM4</sys:String>
                            <sys:String>COM5</sys:String>
                            <sys:String>COM6</sys:String>
                            <sys:String>COM7</sys:String>
                            <sys:String>COM8</sys:String>
                        </ComboBox>
                        <Button Content="Connect"    Command="{Binding ConnectCommand}"    Margin="4,0"/>
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="4,0"/>
                        <Ellipse Width="12" Height="12" Fill="{Binding ComStatus, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" Margin="8,0"/>
                        <TextBlock Text="{Binding ComStatus}" VerticalAlignment="Center" Margin="4,0"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding ComTraffic}" FontFamily="Consolas"/>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Error &amp; Event Log" Grid.Column="2" Margin="4">
                <DockPanel>
                    <ToolBar DockPanel.Dock="Top">
                        <Button Content="Sensor Timeout"  Command="{Binding InjectSensorTimeoutCommand}"/>
                        <Button Content="COM Disconnect"  Command="{Binding InjectComDisconnectCommand}"/>
                        <Button Content="Overflow"        Command="{Binding InjectOverflowCommand}"/>
                        <Button Content="Out of Range"    Command="{Binding InjectOutOfRangeCommand}"/>
                    </ToolBar>
                    <DataGrid ItemsSource="{Binding Events}" AutoGenerateColumns="True" IsReadOnly="True"/>
                </DockPanel>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
