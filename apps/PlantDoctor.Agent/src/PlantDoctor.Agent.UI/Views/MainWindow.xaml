<Window x:Class="PlantDoctor.Agent.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PlantDoctor.Agent.UI.ViewModels"
        Title="PlantDoctor.Agent" Height="800" Width="1400">
    <DockPanel>
        <!-- Status Bar -->
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding OllamaStatus}" FontWeight="Bold" Margin="0,0,20,0"/>
                <TextBlock Text="Plant: " FontWeight="Bold"/>
                <TextBlock Text="{Binding PlantId}"/>
            </StackPanel>
        </Border>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Live Log Stream Panel -->
            <GroupBox Header="Live Log Stream" Grid.Column="0" Margin="4">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <DockPanel>
                    <!-- Filter Controls -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="11"/>
                        <TextBox x:Name="FilterTextBox"
                                 Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="150" 
                                 FontSize="11"
                                 VerticalContentAlignment="Center"
                                 GotFocus="FilterTextBox_GotFocus"
                                 LostFocus="FilterTextBox_LostFocus"/>
                        <ComboBox Width="100" Margin="10,0,0,0" 
                                  VerticalContentAlignment="Center"
                                  SelectedValue="{Binding LogLevelFilter, Mode=TwoWay}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="All Levels"/>
                            <ComboBoxItem Content="Info"/>
                            <ComboBoxItem Content="Warning"/>
                            <ComboBoxItem Content="Error"/>
                            <ComboBoxItem Content="Critical"/>
                        </ComboBox>
                        <Button Content="🔄" Width="30" Margin="10,0,0,0" 
                                ToolTip="Refresh logs"
                                Command="{Binding RefreshLogsCommand}"/>
                    </StackPanel>
                    
                    <!-- Log List -->
                    <ListBox ItemsSource="{Binding FilteredLogs}" FontFamily="Consolas" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" 
                                               FontWeight="Bold" Foreground="DarkBlue"/>
                                    <TextBlock Text="{Binding Level}" 
                                               FontWeight="Bold"
                                               Foreground="{Binding Level, Converter={StaticResource LevelToBrushConverter}}"/>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StackTrace}" 
                                               TextWrapping="Wrap" 
                                               Foreground="Gray"
                                               Visibility="{Binding StackTrace, Converter={StaticResource StringToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <!-- AI Chat Panel -->
            <GroupBox Header="AI Chat" Grid.Column="1" Margin="4">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬 " Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <DockPanel>
                    <!-- Chat History -->
                    <ListBox ItemsSource="{Binding Chat}" 
                             DockPanel.Dock="Top"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,5">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" 
                                        Padding="8" Margin="0,2" CornerRadius="4"
                                        Background="{Binding Role, Converter={StaticResource RoleToBrushConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Role}" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Text}" 
                                                   TextWrapping="Wrap" 
                                                   LineHeight="18"
                                                   LineStackingStrategy="BlockLineHeight"/>
                                        <TextBlock Text="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss}}" 
                                                   Foreground="Gray" 
                                                   FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Chat Input and Controls -->
                    <DockPanel DockPanel.Dock="Bottom" LastChildFill="True">
                        <!-- Buttons Row -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                            <Button Content="📤 Export" 
                                    Command="{Binding ExportChatCommand}" 
                                    Margin="0,0,5,0"
                                    ToolTip="Export chat history"/>
                            <Button Content="🗑️ Clear" 
                                    Command="{Binding ClearChatCommand}" 
                                    Margin="0,0,5,0"
                                    ToolTip="Clear chat history"/>
                            <Button Content="➤ Send" 
                                    Command="{Binding SendChatCommand}" 
                                    IsDefault="True"
                                    Width="70"
                                    FontWeight="Bold"/>
                        </StackPanel>
                        <!-- Chat Input TextBox -->
                        <TextBox x:Name="ChatInputTextBox"
                                 Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}" 
                                 KeyDown="ChatTextBox_KeyDown"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 MinHeight="50"
                                 MaxHeight="120"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 Foreground="Gray"
                                 GotFocus="ChatInputTextBox_GotFocus"
                                 LostFocus="ChatInputTextBox_LostFocus"
                                 DockPanel.Dock="Bottom"/>
                    </DockPanel>
                </DockPanel>
            </GroupBox>

            <!-- Incidents Panel -->
            <GroupBox Header="Incidents" Grid.Column="2" Margin="4">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️ " Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding}" FontWeight="Bold"/>
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                <DockPanel>
                    <!-- Usage Instructions -->
                    <TextBlock DockPanel.Dock="Top" 
                               Text="Incidents are automatically detected when errors occur. Click 'Export' to save diagnostic artifacts for each incident."
                               TextWrapping="Wrap"
                               Foreground="Gray"
                               FontSize="11"
                               Margin="0,0,0,8"
                               FontStyle="Italic"/>
                    
                    <!-- AI Analyzing Indicator -->
                    <TextBlock DockPanel.Dock="Top"
                               Text="🤖 AI is analyzing incidents in background..."
                               TextWrapping="Wrap"
                               Foreground="Blue"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="0,0,0,8"
                               Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <!-- Incidents List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Incidents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gray" BorderThickness="1" 
                                            Padding="8" Margin="0,4" CornerRadius="4"
                                            Background="#FFF5F5">
                                        <StackPanel>
                                            <!-- Incident Header -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Entry.Level}" 
                                                           FontWeight="Bold" 
                                                           Foreground="Red"
                                                           FontSize="12"/>
                                                <TextBlock Text=" - " Margin="4,0,4,0"/>
                                                <TextBlock Text="{Binding Entry.Source}" 
                                                           FontWeight="Bold"
                                                           Foreground="DarkBlue"/>
                                                <TextBlock Text=" | " Margin="4,0,4,0"/>
                                                <TextBlock Text="{Binding Entry.Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                                           Foreground="Gray"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            
                                            <!-- Incident Details -->
                                            <TextBlock Text="{Binding Entry.Message}" 
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Entry.SensorName}" 
                                                       Foreground="Blue"
                                                       Visibility="{Binding Entry.SensorName, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            
                                            <!-- AI Analysis -->
                                            <Border BorderBrush="LightBlue" BorderThickness="1" 
                                                    Padding="6" Margin="0,4,0,4" CornerRadius="3"
                                                    Background="#F0F8FF">
                                                <StackPanel>
                                                    <TextBlock Text="AI Analysis:" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding AiSummary}" 
                                                               TextWrapping="Wrap"
                                                               LineHeight="16"/>
                                                </StackPanel>
                                            </Border>
                                            
                                            <!-- Export Button -->
                                            <Button Content="📥 Export Diagnostic Artifact"
                                                    Command="{Binding DataContext.ExportArtifactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" 
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
