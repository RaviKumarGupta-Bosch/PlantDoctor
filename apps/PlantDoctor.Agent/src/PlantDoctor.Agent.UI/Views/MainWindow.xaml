<Window x:Class="PlantDoctor.Agent.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlantDoctor.Agent" Height="760" Width="1360">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#EEE" Padding="8">
            <TextBlock Text="{Binding OllamaStatus}" FontWeight="Bold"/>
        </Border>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Live Log Stream" Grid.Column="0" Margin="4">
                <ListBox ItemsSource="{Binding LiveLog}" FontFamily="Consolas">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" ToolTip="{Binding StackTrace}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <GroupBox Header="AI Chat" Grid.Column="1" Margin="4">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom">
                        <Button Content="Send" DockPanel.Dock="Right" Command="{Binding SendChatCommand}" Margin="4,0,0,0"/>
                        <TextBox Text="{Binding ChatInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Chat}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="{Binding Role}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Incidents" Grid.Column="2" Margin="4">
                <ItemsControl ItemsSource="{Binding Incidents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,4" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Entry.Level}" FontWeight="Bold" Foreground="Red"/>
                                    <TextBlock Text="{Binding Entry.Message}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding AiSummary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <Button Content="Export Diagnostic Artifact"
                                            Command="{Binding DataContext.ExportArtifactCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
